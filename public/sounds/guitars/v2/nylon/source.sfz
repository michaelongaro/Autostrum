// Meta Nylon Guitar: reference SFZ map of README.md.
//
// Play style is chosen by keyswitch, below the playable range:
//   C1 (24)  Auto, the default: Finger, light pick and firm pick crossfade
//            across velocity (splits near 42 and 85), the README's ordered ramp.
//   C#1 (25) Finger: the fingerstyle take at every velocity.
//   D1 (26)  Pick: light pick crossfading into firm pick around velocity 64.
// The takes are only about 5 dB apart, so velocity also scales level, by up to
// about 8 dB, in every style.
//
// MIDI channel 1 plays each pitch E2-B5 on one string: the lowest string that
// reaches it at fret 4 or below (first position), and High E from E4 up.
// Channels 2-7 each play a single string, Low E to High E, over that string's
// sampled range.
//
// Notes ring out (one-shot), as the README asks. A new note on a string cuts
// the note already ringing on it (group / off_by), across all channels, so at
// most six notes sound at once.

<global>
sw_lokey=24
sw_hikey=26
sw_default=24
loop_mode=one_shot
off_mode=normal
amp_veltrack=60
pitch_random=4
amp_random=1.5

<master> lochan=1 hichan=1

<group> sw_last=24 group=1 off_by=1 lovel=1 hivel=50 xfout_lovel=35 xfout_hivel=50
<region> key=40 sample=INSGuitarNylon_StringLowE_Vel01Finger_E2_01.wav
<region> key=41 sample=INSGuitarNylon_StringLowE_Vel01Finger_F2_01.wav
<region> key=42 sample=INSGuitarNylon_StringLowE_Vel01Finger_Fs2_01.wav
<region> key=43 sample=INSGuitarNylon_StringLowE_Vel01Finger_G2_01.wav
<region> key=44 sample=INSGuitarNylon_StringLowE_Vel01Finger_Gs2_01.wav

