// Meta Steel Guitar: reference SFZ map of README.md.
//
// MIDI channel 1 plays each pitch E2-C6 on one string: the lowest string that
// reaches it at fret 4 or below (first position), and High E from E4 up.
// Channels 2-7 each play a single string, Low E to High E, over that string's
// sampled range, for parts that choose strings themselves.
//
// Velocity: README's 1-48 / 49-96 / 97-127, switched rather than crossfaded,
// with 3 dB of gain across each layer. A new note on a string cuts the note
// already ringing on it (group / off_by), across all channels, so at most six
// notes sound at once, as on a real guitar.

<global>
ampeg_release=0.05
pitch_random=4
amp_random=1.5
off_mode=normal

<master> lochan=1 hichan=1

<group> group=1 off_by=1 lovel=1 hivel=48 amp_velcurve_1=0.708 amp_velcurve_48=1
<region> key=40 sample=INSGuitarSteel_StringLowE_Vel01_E2_01.wav
<region> key=41 sample=INSGuitarSteel_StringLowE_Vel01_F2_01.wav
<region> key=42 sample=INSGuitarSteel_StringLowE_Vel01_Fs2_01.wav
<region> key=43 sample=INSGuitarSteel_StringLowE_Vel01_G2_01.wav
<region> key=44 sample=INSGuitarSteel_StringLowE_Vel01_Gs2_01.wav

